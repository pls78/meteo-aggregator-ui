# Copy to `.env` for local development. Base the API client uses. Relative
# `/api` (default) → the Vite dev proxy (vite.config.ts) forwards it to the
# backend (same-origin, no CORS in dev).
VITE_API_BASE_URL=/api

# Dev-only: where the Vite proxy forwards /api (the running backend).
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Deployed vs. local -----------------------------------------------------
# The production API URL lives in the committed `.env.production`, which Vite
# loads ONLY for `npm run build`. So local (`npm run dev`) and the deployed
# build stay separate automatically — no need to set VITE_API_BASE_URL here for
# production. To point the deployed build elsewhere, edit `.env.production`.
