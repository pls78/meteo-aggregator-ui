# Base the API client uses. Relative `/api` (default) → the Vite dev proxy
# (vite.config.ts) forwards it to the backend (same-origin, no CORS in dev).
# For a cross-origin production backend, set an absolute URL
# (e.g. https://api.example.com).
VITE_API_BASE_URL=/api

# Dev-only: where the Vite proxy forwards /api (the running backend).
VITE_API_PROXY_TARGET=http://localhost:8000
