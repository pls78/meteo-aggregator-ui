# Copy to `.env` for local development. Base the API client uses. Relative
# `/api` (default) → the Vite dev proxy (vite.config.ts) forwards it to the
# backend (same-origin, no CORS in dev).
VITE_API_BASE_URL=/api

# Dev-only: where the Vite proxy forwards /api (the running backend).
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Deployed vs. local -----------------------------------------------------
# Vite loads `.env.production` ONLY for `npm run build`, so local (`npm run dev`)
# and the deployed build stay separate automatically — no need to set
# VITE_API_BASE_URL here for production.
#
# `.env.production` also uses /api: in production a Cloudflare Pages Function
# (functions/api/) proxies it to the backend. The backend URL is the API_ORIGIN
# secret on the Pages project, never in this repo or the JS bundle.
