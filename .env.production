# Production build config (used by `npm run build`, i.e. Vite "production" mode).
# Overrides the generic .env, so a production bundle always targets a deployed
# API regardless of your local .env.
#
# The value below is a PLACEHOLDER. Point it at your own backend
# (../meteo-aggregator-api, deployed anywhere) in one of two ways:
#
#   1. .env.production.local — same key, real URL. Gitignored via *.local and
#      loaded ahead of this file, so `npm run build` needs no extra flags.
#   2. VITE_API_BASE_URL=https://your-backend npm run build
#
# Whatever you set is baked into the JS bundle at build time and is therefore
# public to anyone loading the site — never put a secret here.
#
# Local development is unaffected: `npm run dev` runs in "development" mode and
# does NOT load this file; it uses .env (VITE_API_BASE_URL=/api) → the Vite dev
# proxy → your local backend on :8000.
VITE_API_BASE_URL=https://your-backend.example.com
