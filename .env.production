# Production build config (used by `npm run build`, i.e. Vite "production" mode).
# Overrides the generic .env, so a production bundle always targets the deployed
# API regardless of your local .env. No secrets here — just the public API URL.
#
# Local development is unaffected: `npm run dev` runs in "development" mode and
# does NOT load this file; it uses .env (VITE_API_BASE_URL=/api) → the Vite dev
# proxy → your local backend on :8000.
VITE_API_BASE_URL=https://your-backend.example.com
